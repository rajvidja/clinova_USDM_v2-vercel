{
  "name": "protocoliq",
  "version": "2.0.0",
  "private": true,
  "description": "ProtocolIQ - Protocol Digitisation and rule-based ICH Protocol Builder on a common structured study database",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web,ocr -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:ocr\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "dev:ocr": "bash scripts/run-ocr.sh",
    "ocr:setup": "bash scripts/setup-ocr.sh",
    "ocr:models": ".venv-ocr/bin/python -m ocr_service.download_models",
    "ocr:fixtures": "tsx scripts/make-ocr-fixtures.ts",
    "test:ocr": ".venv-ocr/bin/python -m unittest discover -s ocr_service/tests -t . -v",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:example": "tsx scripts/seed-example.ts",
    "test": "tsx --test tests/*.test.ts",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "docx": "^9.15.1",
    "express": "^5.3.0",
    "lucide-react": "^1.67.0",
    "mammoth": "^1.13.0",
    "node-html-parser": "^9.0.6",
    "pdfmake": "^0.3.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/nft": "^1.11.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "22.x"
  }
}
