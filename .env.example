# --- Vercel project (Settings -> Environment Variables) ---
# Public base URL of the hosted OCR service (ocr_service/Dockerfile). Leave unset to run without OCR.
OCR_SERVICE_URL=https://protocoliq-ocr.example.com
# Shared secret; must match OCR_API_TOKEN on the OCR service. Generate with: openssl rand -hex 32
OCR_API_TOKEN=
# Optional: URL browsers use for uploads/page images, if different from OCR_SERVICE_URL.
# OCR_PUBLIC_URL=
# Demo mode (default 1 on Vercel): temporary database seeded with the EXA-101 example.
# PROTOCOLIQ_DEMO=1

# --- OCR service (Render / Railway / Fly.io / any Docker host) ---
# OCR_API_TOKEN=            same value as above (required when not bound to localhost)
# OCR_CORS_ORIGINS=https://your-app.vercel.app   comma-separated browser origins allowed to upload
# OCR_RETENTION_HOURS=72    uploaded files and results are deleted after this many hours
# OCR_MAX_UPLOAD_MB=200
