# Session signing secret (required in production). Generate a long random string.
PROTOCOLIQ_SESSION_SECRET=

# Password for the seeded demo accounts (admin, steward, author, reviewer, viewer).
PROTOCOLIQ_DEMO_PASSWORD=ProtocolIQ-demo

# Hide demo account hints on the login page.
PROTOCOLIQ_HIDE_DEMO_ACCOUNTS=0

# Session lifetime in hours (default 8).
PROTOCOLIQ_SESSION_HOURS=8

# SQLite database path (defaults to ./data/protocoliq.db). On Vercel this is /tmp.
# PROTOCOLIQ_DB=./data/protocoliq.db

# Demo mode: seed the synthetic example on an empty database (set automatically on Vercel).
# PROTOCOLIQ_DEMO=1

# OCR service (optional; Protocol Digitisation of scanned PDFs / images).
# OCR_SERVICE_URL=http://127.0.0.1:8090
# OCR_API_TOKEN=
