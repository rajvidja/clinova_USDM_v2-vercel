{
  "description": "Default ProtocolIQ data governance rules. Seeded into governance_rules on first start; administrators manage them in the Governance Rules Manager. Generic check types: required, pattern, date, numeric, min-count, unique, allowed-values, terminology, max-length. 'builtin' checks run named procedures in server/governance/quality.ts.",
  "rules": [
    { "id": "C-001", "name": "Protocol title present", "category": "completeness", "severity": "Critical", "entityType": "study", "checkType": "required", "config": { "field": "title" } },
    { "id": "C-002", "name": "Protocol number present", "category": "completeness", "severity": "Critical", "entityType": "study", "checkType": "required", "config": { "field": "protocolNumber" } },
    { "id": "C-003", "name": "Sponsor present", "category": "completeness", "severity": "High", "entityType": "study", "checkType": "required", "config": { "field": "sponsorName" } },
    { "id": "C-004", "name": "Study design present", "category": "completeness", "severity": "High", "entityType": "study", "checkType": "required", "config": { "field": "studyDesign" } },
    { "id": "C-005", "name": "At least one primary objective", "category": "completeness", "severity": "Critical", "entityType": "objective", "checkType": "min-count", "config": { "where": { "category": "Primary" }, "nonEmpty": "description", "min": 1 } },
    { "id": "C-006", "name": "At least one primary endpoint", "category": "completeness", "severity": "Critical", "entityType": "endpoint", "checkType": "min-count", "config": { "where": { "category": "Primary" }, "nonEmpty": "name", "min": 1 } },
    { "id": "C-007", "name": "Inclusion criteria present", "category": "completeness", "severity": "Critical", "entityType": "criterion", "checkType": "min-count", "config": { "where": { "type": "inclusion" }, "nonEmpty": "text", "min": 1 } },
    { "id": "C-008", "name": "Exclusion criteria present", "category": "completeness", "severity": "Critical", "entityType": "criterion", "checkType": "min-count", "config": { "where": { "type": "exclusion" }, "nonEmpty": "text", "min": 1 } },
    { "id": "C-009", "name": "At least one study arm", "category": "completeness", "severity": "High", "entityType": "arm", "checkType": "min-count", "config": { "min": 1 } },
    { "id": "C-010", "name": "Intervention named for each arm", "category": "completeness", "severity": "High", "entityType": "arm", "checkType": "required", "config": { "field": "interventionName" } },
    { "id": "C-011", "name": "Dosage recorded for each arm", "category": "completeness", "severity": "Medium", "entityType": "arm", "checkType": "required", "config": { "field": "dosage" } },
    { "id": "C-012", "name": "Route recorded for each arm", "category": "completeness", "severity": "Medium", "entityType": "arm", "checkType": "required", "config": { "field": "route" } },
    { "id": "C-013", "name": "Frequency recorded for each arm", "category": "completeness", "severity": "Medium", "entityType": "arm", "checkType": "required", "config": { "field": "frequency" } },
    { "id": "C-014", "name": "Treatment duration recorded for each arm", "category": "completeness", "severity": "Low", "entityType": "arm", "checkType": "required", "config": { "field": "duration" } },
    { "id": "C-015", "name": "Schedule of Activities has visits and assessments", "category": "completeness", "severity": "High", "entityType": "visit", "checkType": "builtin", "config": { "key": "soa-required-information" } },
    { "id": "C-016", "name": "Visit timing recorded", "category": "completeness", "severity": "Medium", "entityType": "visit", "checkType": "required", "config": { "field": "timing" } },
    { "id": "C-017", "name": "Protocol version recorded", "category": "completeness", "severity": "High", "entityType": "protocol", "checkType": "required", "config": { "field": "version" } },

    { "id": "K-001", "name": "Study identifier unique across studies", "category": "consistency", "severity": "Critical", "entityType": "study", "checkType": "unique", "config": { "field": "protocolNumber", "scope": "all-studies" } },
    { "id": "K-002", "name": "Endpoint identifiers unique", "category": "consistency", "severity": "High", "entityType": "endpoint", "checkType": "unique", "config": { "field": "code", "scope": "protocol" } },
    { "id": "K-003", "name": "Objective identifiers unique", "category": "consistency", "severity": "High", "entityType": "objective", "checkType": "unique", "config": { "field": "code", "scope": "protocol" } },
    { "id": "K-004", "name": "Arm identifiers unique", "category": "consistency", "severity": "High", "entityType": "arm", "checkType": "unique", "config": { "field": "code", "scope": "protocol" } },
    { "id": "K-005", "name": "No conflicting protocol versions", "category": "consistency", "severity": "High", "entityType": "protocol", "checkType": "builtin", "config": { "key": "conflicting-protocol-versions" } },
    { "id": "K-006", "name": "Visit names consistent", "category": "consistency", "severity": "Medium", "entityType": "visit", "checkType": "builtin", "config": { "key": "inconsistent-visit-names" } },
    { "id": "K-007", "name": "Study arm references consistent", "category": "consistency", "severity": "Medium", "entityType": "arm", "checkType": "builtin", "config": { "key": "inconsistent-arm-references" } },
    { "id": "K-008", "name": "Endpoints linked to an objective", "category": "consistency", "severity": "Medium", "entityType": "endpoint", "checkType": "builtin", "config": { "key": "endpoint-without-objective", "categories": ["Primary", "Secondary", "Exploratory"] } },
    { "id": "K-009", "name": "Activities reference existing visits", "category": "consistency", "severity": "High", "entityType": "activity", "checkType": "builtin", "config": { "key": "activity-nonexistent-visit" } },
    { "id": "K-010", "name": "Relationship references resolve", "category": "consistency", "severity": "High", "entityType": "*", "checkType": "builtin", "config": { "key": "invalid-relationship-references" } },
    { "id": "K-011", "name": "Endpoint timepoints match scheduled visits", "category": "consistency", "severity": "Low", "entityType": "endpoint", "checkType": "builtin", "config": { "key": "cross-section-conflict" } },
    { "id": "K-012", "name": "Assessments scheduled at a visit", "category": "consistency", "severity": "Medium", "entityType": "activity", "checkType": "builtin", "config": { "key": "activity-unscheduled" } },

    { "id": "V-001", "name": "Protocol date format (YYYY-MM-DD)", "category": "validity", "severity": "Medium", "entityType": "protocol", "checkType": "date", "config": { "field": "protocolDate" } },
    { "id": "V-002", "name": "Amendment date format (YYYY-MM-DD)", "category": "validity", "severity": "Medium", "entityType": "protocol", "checkType": "date", "config": { "field": "amendmentDate" } },
    { "id": "V-003", "name": "Protocol version format", "category": "validity", "severity": "Medium", "entityType": "protocol", "checkType": "pattern", "config": { "field": "version", "pattern": "^\\d+(\\.\\d+){0,2}$", "expected": "Numeric version such as 1.0 or 2.1.3" } },
    { "id": "V-004", "name": "Dosage format (amount and unit)", "category": "validity", "severity": "Low", "entityType": "arm", "checkType": "pattern", "config": { "field": "dosage", "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(mg|g|mcg|µg|ug|ng|mL|L|IU|U|mg/kg|mg/m2|mg/m²|µg/kg|mcg/kg|%)\\b", "flags": "i", "expected": "A number followed by a unit, e.g. '10 mg' or '2.5 mg/kg'" } },
    { "id": "V-005", "name": "Numeric fields contain numbers", "category": "validity", "severity": "Medium", "entityType": "subsection", "checkType": "builtin", "config": { "key": "numeric-fields" } },
    { "id": "V-006", "name": "Study phase uses supported terminology", "category": "validity", "severity": "Medium", "entityType": "study", "checkType": "terminology", "config": { "field": "phase", "domain": "study_phase" } },
    { "id": "V-007", "name": "Route uses supported terminology", "category": "validity", "severity": "Low", "entityType": "arm", "checkType": "terminology", "config": { "field": "route", "domain": "route" } },
    { "id": "V-008", "name": "Frequency uses supported terminology", "category": "validity", "severity": "Low", "entityType": "arm", "checkType": "terminology", "config": { "field": "frequency", "domain": "frequency" } },
    { "id": "V-009", "name": "Endpoint category uses supported terminology", "category": "validity", "severity": "Medium", "entityType": "endpoint", "checkType": "terminology", "config": { "field": "category", "domain": "endpoint_level" } },
    { "id": "V-010", "name": "Arm type uses supported terminology", "category": "validity", "severity": "Low", "entityType": "arm", "checkType": "terminology", "config": { "field": "armType", "domain": "arm_type" } },
    { "id": "V-011", "name": "USDM references resolve", "category": "validity", "severity": "Critical", "entityType": "*", "checkType": "builtin", "config": { "key": "usdm-invalid-references" } },
    { "id": "V-012", "name": "USDM schema validation passes", "category": "validity", "severity": "Critical", "entityType": "*", "checkType": "builtin", "config": { "key": "usdm-schema-errors" } },

    { "id": "T-001", "name": "Digitised elements reference a source document", "category": "traceability", "severity": "High", "entityType": "*", "checkType": "builtin", "config": { "key": "missing-source-reference" } },
    { "id": "T-002", "name": "OCR-derived elements carry a page number", "category": "traceability", "severity": "Medium", "entityType": "*", "checkType": "builtin", "config": { "key": "missing-page-number" } },
    { "id": "T-003", "name": "Digitised elements record their source section", "category": "traceability", "severity": "Low", "entityType": "*", "checkType": "builtin", "config": { "key": "missing-source-section" } },
    { "id": "T-004", "name": "Study has USDM mapping history", "category": "traceability", "severity": "Informational", "entityType": "study", "checkType": "builtin", "config": { "key": "missing-mapping-history" } },
    { "id": "T-005", "name": "Study has a data owner", "category": "traceability", "severity": "Medium", "entityType": "study", "checkType": "builtin", "config": { "key": "missing-ownership" } },
    { "id": "T-006", "name": "Core elements have review history", "category": "traceability", "severity": "Low", "entityType": "*", "checkType": "builtin", "config": { "key": "missing-review-history", "types": ["objective", "endpoint", "arm", "criterion"] } }
  ]
}
