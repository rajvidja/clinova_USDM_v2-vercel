{
  "group": "Study Arms & Interventions",
  "description": "Treatment arms (ICH E6 6.1) and the study interventions administered in them.",
  "rules": [
    { "sourceEntity": "arm", "sourceField": "code", "targetEntity": "StudyArm", "targetProperty": "name", "type": "direct", "status": "Mapped", "rule": { "fallback": "name" } },
    { "sourceEntity": "arm", "sourceField": "name", "targetEntity": "StudyArm", "targetProperty": "label", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "arm", "sourceField": "armType", "targetEntity": "StudyArm", "targetProperty": "type", "type": "terminology", "status": "Mapped", "rule": { "domain": "arm_type", "as": "Code" } },
    { "sourceEntity": "arm", "sourceField": "(manual) data origin type", "targetEntity": "StudyArm", "targetProperty": "dataOriginType", "type": "manual", "status": "Requires Review", "rule": { "valueType": "code", "codelist": "C188727", "value": "C188866" }, "reason": "Arms defined in a ProtocolIQ protocol enrol participants whose data is generated within the study. Change for external or historical control arms." },
    { "sourceEntity": "arm", "sourceField": "(manual) data origin description", "targetEntity": "StudyArm", "targetProperty": "dataOriginDescription", "type": "manual", "status": "Requires Review", "rule": { "valueType": "string", "value": "Data collected from participants enrolled in this study" }, "reason": "Default description for arms whose data is generated within the study." },
    { "sourceEntity": "arm", "sourceField": "comparator", "targetEntity": "StudyArm", "targetProperty": "description", "type": "unsupported", "status": "Not Mapped", "reason": "USDM expresses the comparator through the arm type and intervention role rather than a free-text property. The comparator text is preserved in the mapping report." },
    { "sourceEntity": "arm", "sourceField": "interventionName", "targetEntity": "StudyIntervention", "targetProperty": "name", "type": "direct", "status": "Mapped", "reason": "Arms that name the same intervention share one StudyIntervention." },
    { "sourceEntity": "arm", "sourceField": "armType", "targetEntity": "StudyIntervention", "targetProperty": "role", "type": "terminology", "status": "Mapped", "rule": { "domain": "intervention_role", "as": "Code" } },
    { "sourceEntity": "arm", "sourceField": "(manual) intervention type", "targetEntity": "StudyIntervention", "targetProperty": "type", "type": "manual", "status": "Not Mapped", "rule": { "valueType": "code", "codelist": "C99078" }, "reason": "ProtocolIQ does not record whether an intervention is a drug, biologic, device, etc. Configure per study or per arm." },
    { "sourceEntity": "arm", "sourceField": "dosage", "targetEntity": "Administration", "targetProperty": "dose", "type": "value", "status": "Mapped", "rule": { "fn": "dosage" }, "reason": "Parsed as '<number> <unit>' against the CDISC UNIT codelist. Unparseable or unknown units are not converted." },
    { "sourceEntity": "arm", "sourceField": "route", "targetEntity": "Administration", "targetProperty": "route", "type": "terminology", "status": "Mapped", "rule": { "domain": "route", "as": "AliasCode" } },
    { "sourceEntity": "arm", "sourceField": "frequency", "targetEntity": "Administration", "targetProperty": "frequency", "type": "terminology", "status": "Mapped", "rule": { "domain": "frequency", "as": "AliasCode" } },
    { "sourceEntity": "arm", "sourceField": "duration", "targetEntity": "Duration", "targetProperty": "text", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "arm", "sourceField": "duration", "targetEntity": "Duration", "targetProperty": "quantity", "type": "value", "status": "Mapped", "rule": { "fn": "durationQuantity" }, "reason": "Parsed as '<number> <days|weeks|months|years>'." },
    { "sourceEntity": "arm", "sourceField": "(manual) duration will vary", "targetEntity": "Duration", "targetProperty": "durationWillVary", "type": "manual", "status": "Not Mapped", "rule": { "valueType": "boolean" }, "reason": "Whether the treatment duration varies by participant is not captured. Until configured, the Administration is not emitted." },
    { "sourceEntity": "arm", "sourceField": "(relationship) arm to intervention", "targetEntity": "StudyCell", "targetProperty": "elementIds", "type": "unsupported", "status": "Not Mapped", "reason": "USDM links arms to interventions through study cells and study elements within epochs. ProtocolIQ has no epochs, so the link is reported but not created." },
    { "sourceEntity": "arm", "sourceField": "(relationship) design interventions", "targetEntity": "InterventionalStudyDesign", "targetProperty": "studyInterventionIds", "type": "relationship", "status": "Mapped", "rule": { "relationship": "design-interventions" } }
  ]
}
