{
  "group": "Study Design",
  "description": "Interventional study design, design characteristics, blinding and study population.",
  "rules": [
    { "sourceEntity": "study", "sourceField": "protocolNumber", "targetEntity": "InterventionalStudyDesign", "targetProperty": "name", "type": "value", "status": "Mapped", "rule": { "fn": "template", "template": "{protocolNumber} Study Design" } },
    { "sourceEntity": "design", "sourceField": "design.type#description", "targetEntity": "InterventionalStudyDesign", "targetProperty": "rationale", "type": "direct", "status": "Mapped", "rule": { "transform": "plainText" }, "reason": "ICH E6 section 4 'Trial Type, Design' description of the design." },
    { "sourceEntity": "study", "sourceField": "studyDesign", "targetEntity": "InterventionalStudyDesign", "targetProperty": "description", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "study", "sourceField": "(constant)", "targetEntity": "InterventionalStudyDesign", "targetProperty": "studyType", "type": "value", "status": "Requires Review", "rule": { "fn": "constantCode", "codelist": "C99077", "code": "C98388" }, "reason": "The ICH E6 Protocol Builder template describes clinical trials (interventional studies). Confirm for digitised observational protocols." },
    { "sourceEntity": "study", "sourceField": "phase", "targetEntity": "InterventionalStudyDesign", "targetProperty": "studyPhase", "type": "terminology", "status": "Mapped", "rule": { "domain": "study_phase", "as": "AliasCode" } },
    { "sourceEntity": "design", "sourceField": "design.type#trialType", "targetEntity": "InterventionalStudyDesign", "targetProperty": "model", "type": "terminology", "status": "Mapped", "rule": { "domain": "intervention_model", "as": "Code", "priority": 1 } },
    { "sourceEntity": "study", "sourceField": "studyDesign", "targetEntity": "InterventionalStudyDesign", "targetProperty": "model", "type": "terminology", "status": "Mapped", "rule": { "domain": "intervention_model", "as": "Code", "priority": 2 }, "reason": "Used only when the trial type in section 4 does not map." },
    { "sourceEntity": "design", "sourceField": "design.bias#randomization", "targetEntity": "InterventionalStudyDesign", "targetProperty": "characteristics", "type": "terminology", "status": "Mapped", "rule": { "domain": "design_characteristic", "as": "Code", "multiple": true } },
    { "sourceEntity": "design", "sourceField": "design.type#trialType", "targetEntity": "InterventionalStudyDesign", "targetProperty": "characteristics", "type": "terminology", "status": "Mapped", "rule": { "domain": "design_characteristic", "as": "Code", "multiple": true } },
    { "sourceEntity": "design", "sourceField": "design.bias#blinding", "targetEntity": "InterventionalStudyDesign", "targetProperty": "blindingSchema", "type": "terminology", "status": "Mapped", "rule": { "domain": "blinding", "as": "AliasCode" } },
    { "sourceEntity": "study", "sourceField": "(relationship) arms", "targetEntity": "InterventionalStudyDesign", "targetProperty": "arms", "type": "relationship", "status": "Mapped", "rule": { "relationship": "design-arms" } },
    { "sourceEntity": "study", "sourceField": "(relationship) epochs and cells", "targetEntity": "InterventionalStudyDesign", "targetProperty": "studyCells", "type": "unsupported", "status": "Not Mapped", "reason": "ProtocolIQ does not model study epochs or arm/epoch cells. USDM 4.0.0 declares epochs and studyCells as 1..* in the model; the API schema accepts empty arrays, so they are emitted empty and reported as a model-cardinality warning." },
    { "sourceEntity": "study", "sourceField": "studyDesign", "targetEntity": "StudyDesignPopulation", "targetProperty": "name", "type": "value", "status": "Mapped", "rule": { "fn": "template", "template": "{protocolNumber} Study Population" } },
    { "sourceEntity": "design", "sourceField": "background.population#description", "targetEntity": "StudyDesignPopulation", "targetProperty": "description", "type": "direct", "status": "Mapped", "rule": { "transform": "plainText" } },
    { "sourceEntity": "design", "sourceField": "statistics.sampleSize#plannedSampleSize", "targetEntity": "StudyDesignPopulation", "targetProperty": "plannedEnrollmentNumber", "type": "value", "status": "Mapped", "rule": { "fn": "quantity" }, "reason": "Planned total sample size becomes a Quantity without a unit (number of participants)." },
    { "sourceEntity": "design", "sourceField": "(manual) healthy subjects", "targetEntity": "StudyDesignPopulation", "targetProperty": "includesHealthySubjects", "type": "manual", "status": "Not Mapped", "rule": { "valueType": "boolean" }, "reason": "Whether healthy participants are included is not captured as a structured field. Configure a value per study." },
    { "sourceEntity": "design", "sourceField": "(relationship) eligibility", "targetEntity": "StudyDesignPopulation", "targetProperty": "criterionIds", "type": "relationship", "status": "Mapped", "rule": { "relationship": "population-criteria" } },
    { "sourceEntity": "design", "sourceField": "(not captured) planned sex and age", "targetEntity": "StudyDesignPopulation", "targetProperty": "plannedSex", "type": "unsupported", "status": "Not Mapped", "reason": "ProtocolIQ captures sex and age limits only inside eligibility criterion text. They are not parsed into structured values." }
  ]
}
