{
  "group": "Study",
  "description": "Study, study version, titles, identifiers, sponsor organisation and the protocol document.",
  "rules": [
    { "sourceEntity": "study", "sourceField": "protocolNumber", "targetEntity": "Study", "targetProperty": "name", "type": "direct", "status": "Mapped", "rule": { "fallback": "title" } },
    { "sourceEntity": "study", "sourceField": "title", "targetEntity": "Study", "targetProperty": "label", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "study", "sourceField": "title", "targetEntity": "StudyTitle", "targetProperty": "text", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "study", "sourceField": "(constant)", "targetEntity": "StudyTitle", "targetProperty": "type", "type": "value", "status": "Mapped", "rule": { "fn": "constantCode", "codelist": "C207419", "code": "C207616" }, "reason": "ProtocolIQ captures one title: the official protocol title from the title page." },
    { "sourceEntity": "study", "sourceField": "protocolNumber", "targetEntity": "StudyIdentifier", "targetProperty": "text", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "study", "sourceField": "(relationship) sponsor", "targetEntity": "StudyIdentifier", "targetProperty": "scopeId", "type": "relationship", "status": "Mapped", "rule": { "relationship": "identifier-scope" }, "reason": "The protocol number is the sponsor's identifier, so it is scoped to the sponsor organisation." },
    { "sourceEntity": "study", "sourceField": "sponsorName", "targetEntity": "Organization", "targetProperty": "name", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "study", "sourceField": "(manual) organisation identifier", "targetEntity": "Organization", "targetProperty": "identifier", "type": "manual", "status": "Not Mapped", "rule": { "valueType": "string" }, "reason": "ProtocolIQ does not capture a registry identifier (e.g. DUNS) for the sponsor. Configure a value per study." },
    { "sourceEntity": "study", "sourceField": "(manual) organisation identifier scheme", "targetEntity": "Organization", "targetProperty": "identifierScheme", "type": "manual", "status": "Not Mapped", "rule": { "valueType": "string" }, "reason": "The identifier scheme (e.g. DUNS) must be stated with the identifier." },
    { "sourceEntity": "study", "sourceField": "(manual) organisation type", "targetEntity": "Organization", "targetProperty": "type", "type": "manual", "status": "Not Mapped", "rule": { "valueType": "code", "codelist": "C188724" }, "reason": "Sponsor organisation type is not captured; choose a term from the Organization Type codelist." },
    { "sourceEntity": "study", "sourceField": "therapeuticArea", "targetEntity": "InterventionalStudyDesign", "targetProperty": "therapeuticAreas", "type": "unsupported", "status": "Not Mapped", "reason": "USDM therapeutic areas are coded values from an external dictionary (e.g. SNOMED CT, MeSH). ProtocolIQ stores free text and does not bundle those dictionaries." },
    { "sourceEntity": "study", "sourceField": "indication", "targetEntity": "Indication", "targetProperty": "name", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "study", "sourceField": "(manual) rare disease", "targetEntity": "Indication", "targetProperty": "isRareDisease", "type": "manual", "status": "Not Mapped", "rule": { "valueType": "boolean" }, "reason": "Whether the indication is a rare disease is not captured. Until configured, the Indication is not emitted." },
    { "sourceEntity": "protocol", "sourceField": "version", "targetEntity": "StudyVersion", "targetProperty": "versionIdentifier", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "design", "sourceField": "objectives.purpose#purpose", "targetEntity": "StudyVersion", "targetProperty": "rationale", "type": "direct", "status": "Mapped", "rule": { "transform": "plainText" }, "reason": "ICH E6 section 3 'Overall Purpose of the Trial' states the contribution of the study." },
    { "sourceEntity": "protocol", "sourceField": "(relationship) protocol document", "targetEntity": "StudyVersion", "targetProperty": "documentVersionIds", "type": "relationship", "status": "Mapped", "rule": { "relationship": "document-version" }, "reason": "The study version is documented by this protocol version." },
    { "sourceEntity": "protocol", "sourceField": "templateName", "targetEntity": "StudyDefinitionDocument", "targetProperty": "templateName", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "study", "sourceField": "protocolNumber", "targetEntity": "StudyDefinitionDocument", "targetProperty": "name", "type": "value", "status": "Mapped", "rule": { "fn": "template", "template": "{protocolNumber} Protocol" } },
    { "sourceEntity": "protocol", "sourceField": "(constant)", "targetEntity": "StudyDefinitionDocument", "targetProperty": "type", "type": "value", "status": "Mapped", "rule": { "fn": "constantCode", "codelist": "C215477", "code": "C70817" }, "reason": "Every ProtocolIQ document is a clinical study protocol." },
    { "sourceEntity": "protocol", "sourceField": "(manual) language", "targetEntity": "StudyDefinitionDocument", "targetProperty": "language", "type": "manual", "status": "Requires Review", "rule": { "valueType": "isoCode", "value": { "code": "en", "codeSystem": "ISO 639-1", "codeSystemVersion": "2002", "decode": "English" } }, "reason": "The ProtocolIQ template and editor are English. Confirm the document language per study." },
    { "sourceEntity": "protocol", "sourceField": "version", "targetEntity": "StudyDefinitionDocumentVersion", "targetProperty": "version", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "protocol", "sourceField": "status", "targetEntity": "StudyDefinitionDocumentVersion", "targetProperty": "status", "type": "terminology", "status": "Mapped", "rule": { "domain": "document_status", "as": "Code" } },
    { "sourceEntity": "protocol", "sourceField": "protocolDate", "targetEntity": "GovernanceDate", "targetProperty": "dateValue", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "protocol", "sourceField": "(manual) date type", "targetEntity": "GovernanceDate", "targetProperty": "type", "type": "manual", "status": "Not Mapped", "rule": { "valueType": "code", "codelist": "C207413" }, "reason": "ProtocolIQ records a 'protocol date' without stating whether it is the issued, effective or approval date. Until configured, the date is not emitted." },
    { "sourceEntity": "protocol", "sourceField": "(manual) geographic scope", "targetEntity": "GeographicScope", "targetProperty": "type", "type": "manual", "status": "Not Mapped", "rule": { "valueType": "code", "codelist": "C207412" }, "reason": "The geographic scope of the protocol date is not captured." },
    { "sourceEntity": "protocol", "sourceField": "amendmentNumber", "targetEntity": "StudyAmendment", "targetProperty": "number", "type": "unsupported", "status": "Not Mapped", "reason": "A USDM StudyAmendment requires a summary, primary reason, impacts and change list, which ProtocolIQ does not capture as structured data. The value is preserved in the mapping report." },
    { "sourceEntity": "protocol", "sourceField": "amendmentDate", "targetEntity": "StudyAmendment", "targetProperty": "dateValues", "type": "unsupported", "status": "Not Mapped", "reason": "See amendment number: StudyAmendment cannot be built from ProtocolIQ data." },
    { "sourceEntity": "section", "sourceField": "(all fields)", "targetEntity": "NarrativeContentItem", "targetProperty": "text", "type": "value", "status": "Mapped", "rule": { "fn": "xhtml" }, "reason": "Subsection content is rendered as XHTML narrative. Structured widgets (objectives, criteria, arms, SoA) are emitted as structured USDM entities instead." },
    { "sourceEntity": "section", "sourceField": "subsectionTitle", "targetEntity": "NarrativeContent", "targetProperty": "sectionTitle", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "section", "sourceField": "subsectionNumber", "targetEntity": "NarrativeContent", "targetProperty": "sectionNumber", "type": "direct", "status": "Mapped" },
    { "sourceEntity": "section", "sourceField": "(relationship) document order", "targetEntity": "NarrativeContent", "targetProperty": "previousId", "type": "relationship", "status": "Mapped", "rule": { "relationship": "narrative-order" } },
    { "sourceEntity": "section", "sourceField": "(relationship) section content", "targetEntity": "NarrativeContent", "targetProperty": "contentItemId", "type": "relationship", "status": "Mapped", "rule": { "relationship": "narrative-item" } }
  ]
}
